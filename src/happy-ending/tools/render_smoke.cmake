# CTest happy_ending_render_smoke: runs the render tool into a scratch folder and checks front.png (PNG signature,
# IHDR 1280 x 890). Prints "SKIP:" (test skipped) when the tool has not been built (it is EXCLUDE_FROM_ALL).
#   cmake -DTOOL=<happy_ending_render> -DOUT=<scratch dir> -P render_smoke.cmake
if(NOT EXISTS "${TOOL}")
  message("SKIP: render tool not built: ${TOOL}")
  return()
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${TOOL}" "${OUT}" no-grain RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "render tool failed: ${rc}")
endif()
if(NOT EXISTS "${OUT}/front.png")
  message(FATAL_ERROR "front.png not written")
endif()
file(READ "${OUT}/front.png" head LIMIT 24 HEX)
string(SUBSTRING "${head}" 0 16 signature)
string(SUBSTRING "${head}" 24 8 chunk)
string(SUBSTRING "${head}" 32 8 width)
string(SUBSTRING "${head}" 40 8 height)
if(NOT signature STREQUAL "89504e470d0a1a0a" OR NOT chunk STREQUAL "49484452")
  message(FATAL_ERROR "front.png is not a PNG: ${head}")
endif()
if(NOT width STREQUAL "00000500" OR NOT height STREQUAL "0000037a")
  message(FATAL_ERROR "front.png is not 1280 x 890: width ${width}, height ${height} (hex)")
endif()
message("front.png: PNG 1280 x 890")
